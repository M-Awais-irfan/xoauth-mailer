{
	"name": "m-awais-irfan/xoauth-mailer",
	"description": "WordPress plugin that sends site email through Google Workspace SMTP using OAuth2 (XOAUTH2) or an App Password.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"homepage": "https://github.com/M-Awais-irfan/xoauth-mailer",
	"authors": [
		{
			"name": "Awais Irfan",
			"homepage": "https://awaisirfan.com/"
		}
	],
	"require": {
		"php": ">=8.0"
	},
	"require-dev": {
		"wp-coding-standards/wpcs": "^3.2",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpmailer/phpmailer": "^6.9"
	},
	"scripts": {
		"lint": "phpcs",
		"test": "php tests/run.php"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	}
}
